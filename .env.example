# ===========================================
# AwardOS Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# Application
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# Transactional email (required for EMAIL_OTP voting)
# -------------------------------------------
# Without these, ballots using the EMAIL_OTP verification method cannot be cast:
# no code is ever sent. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain you have verified in Resend.
RESEND_FROM_EMAIL=AwardOS <noreply@yourdomain.com>

# -------------------------------------------
# AI Provider Keys (users configure their own)
# At least one is needed for AI features
# -------------------------------------------
# Which provider the AI features default to: google | openai | anthropic
NEXT_PUBLIC_DEFAULT_AI_PROVIDER=google

# Google Gemini — https://aistudio.google.com/apikey
# This exact name is required: it is the only one @ai-sdk/google reads.
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -------------------------------------------
# Notifier + Verifier (optional)
# -------------------------------------------
# Slack webhook for critical alert notifications (optional)
SLACK_WEBHOOK_URL=

# Database connection for scripts/verifiers
DATABASE_URL=postgres://user:pass@localhost:5432/awardos_dev

# -------------------------------------------
# Scheduled jobs
# -------------------------------------------
# Shared secret for /api/admin/purge-accounts, the cron that erases accounts
# whose 30-day deletion grace window has closed (FR-AUTH-06). Vercel Cron sends
# it as `Authorization: Bearer $CRON_SECRET`. The route returns 503 while this is
# unset, so deletions simply never finalize — set it in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Example EVENT_ID for the verifier script
# EVENT_ID=<event-id>

# File watch / dev options
# CHOKIDAR_USEPOLLING=false
# NEXT_IGNORE_TYPECHECK=true  # not recommended for production
